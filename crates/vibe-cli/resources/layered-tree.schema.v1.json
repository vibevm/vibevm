{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vibe layered tree v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "command", "schema_version", "project", "layers"],
  "properties": {
    "ok": {"const": true},
    "command": {"const": "tree:layers"},
    "schema_version": {"const": 1},
    "project": {"$ref": "package-tree.schema.v1.json"},
    "layers": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "enabled", "state", "root", "tree", "diagnostics"],
      "properties": {
        "id": {"enum": ["project", "user", "override"]},
        "enabled": {"type": "boolean"},
        "state": {"enum": ["available", "absent", "unavailable"]},
        "root": {"type": ["string", "null"]},
        "tree": {"anyOf": [{"$ref": "package-tree.schema.v1.json"}, {"type": "null"}]},
        "diagnostics": {"type": "array", "items": {"type": "string"}}
      }
    }}
  }
}
