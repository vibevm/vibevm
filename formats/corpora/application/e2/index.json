{
  "protocol": "vibe-user-applications/3",
  "installations": {
    "org.example/editor@1.2.0": {
      "slot": "editor",
      "package": { "group": "org.example", "name": "editor", "version": "1.2.0" },
      "option": "linux-zip",
      "platform": "linux",
      "arch": "x86_64",
      "method": "zip",
      "library": "default",
      "directory": "apps/editor/org.example.editor@1.2.0",
      "portable": true,
      "launchers": [
        {
          "id": "main",
          "name": "Editor",
          "executable": "$app_bin/editor",
          "args": ["--fixed"],
          "workingDirectory": "$project_root",
          "terminal": true,
          "default": true
        }
      ],
      "publicCommands": [{ "name": "edit", "launcher": "main" }],
      "commands": {},
      "requiredBy": ["org.example/editor-apt@2.0.0"]
    },
    "org.example/editor-apt@2.0.0": {
      "slot": "editor",
      "package": { "group": "org.example", "name": "editor-apt", "version": "2.0.0" },
      "option": "ubuntu-apt",
      "platform": "ubuntu",
      "arch": "x86_64",
      "method": "shell",
      "appRoot": "/usr/lib/editor",
      "portable": false,
      "launchers": [],
      "publicCommands": [],
      "commands": {
        "uninstall": "sudo apt-get remove editor",
        "forceUninstall": "sudo apt-get purge editor",
        "update": "sudo apt-get install --only-upgrade editor",
        "interpreter": "posix_sh"
      },
      "features": ["docs"],
      "parameters": { "port": "8080" },
      "license": { "name": "Demo", "acceptedAt": "2026-10-31T00:00:00Z" },
      "icon": "share/icon.png",
      "steps": [
        { "id": "install", "kind": "shell", "outcome": "done" },
        {
          "id": "register",
          "kind": "shell",
          "outcome": "done",
          "uninstall": "editor-register --remove",
          "interpreter": "posix_sh"
        },
        { "id": "fix", "kind": "agent", "phase": "finish", "outcome": "skipped" }
      ],
      "hidden": true,
      "mark": "auto",
      "requires": [
        { "package": "org.example/editor@1", "key": "org.example/editor@1.2.0", "scope": "runtime" },
        { "package": "org.example/gcc@13", "key": "org.example/gcc@13.2.0", "scope": "build", "step": "register" }
      ],
      "env": [
        { "step": "fix", "op": "set", "name": "EDITOR_HOME", "value": "/usr/lib/editor" },
        {
          "step": "fix",
          "op": "path_prepend",
          "name": "PATH",
          "value": "/usr/lib/editor/bin",
          "previous": "%USERPROFILE%\\bin",
          "previousKind": "expand_string"
        }
      ],
      "held": true,
      "replaced": "org.example/editor-apt@1.9.0"
    }
  },
  "slots": {
    "editor": { "default": "org.example/editor@1.2.0" }
  }
}
