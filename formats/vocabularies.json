{
  "package_kind": {
    "metadata": {
      "x-vocabulary": "open",
      "description": "Installable package kind (VIBEVM-SPEC §4.1). Open vocabulary: the register grows by owner amendment, so a reader must not hard-fail on an unseen kind."
    },
    "enum": ["flow", "feat", "stack", "tool", "mcp", "lang"]
  },
  "delivery_mode": {
    "metadata": {
      "x-vocabulary": "open",
      "description": "Subskill materialisation mode. Open vocabulary: modes are a growing register, not a closed set."
    },
    "enum": ["eager", "lazy-push", "lazy-pull"]
  },
  "naming_convention": {
    "metadata": {
      "x-vocabulary": "closed",
      "x-rust-type": "NamingConvention",
      "description": "Repository naming convention mapping a pkgref to a repo name (PROP-008 §2.5). Closed vocabulary: repository paths are built from these values, so an unfamiliar one has no safe behaviour. The four wire strings are explicit per-variant renames, not one rename rule — `kind-name` and `kind/name` are not derivable from a single case convention. Two copies exist in code (`vibe-index/src/types/kinds.rs` and `vibe-core/src/manifest/project.rs`) with identical strings today; the index-side test `naming_convention_serde_matches_vibe_core_wire` pins them, and Phase 4.2 converges the copies. Shared as a vocabulary because `repomd` and `journal` both carry it."
    },
    "enum": ["fqdn", "kind-name", "name", "kind/name"]
  },
  "group": {
    "metadata": {
      "x-rust-type": "Group",
      "description": "Reverse-FQDN namespace qualifier (PROP-008 §2.1) — the `vibe_core::Group` newtype on the wire."
    },
    "type": "string"
  },
  "version": {
    "metadata": {
      "x-rust-type": "semver::Version",
      "description": "Semantic version string — `semver::Version` in code."
    },
    "type": "string"
  },
  "timestamp": {
    "metadata": {
      "x-rust-type": "chrono::DateTime<Utc>",
      "description": "RFC 3339 timestamp — `chrono::DateTime<Utc>` in code."
    },
    "type": "string"
  },
  "boot_snippet_entry": {
    "metadata": {
      "description": "`[boot_snippet]` projection (PROP-005 §2.6): a boot file identified by its `source` path plus an ordering `category`."
    },
    "properties": {
      "source": {
        "type": "string"
      }
    },
    "optionalProperties": {
      "category": {
        "type": "string",
        "metadata": {
          "description": "Ordering band for the computed boot sequence — `foundation` / `flow` / `stack` / `user-override`."
        }
      }
    }
  },
  "compatibility_entry": {
    "metadata": {
      "description": "Compatibility projection: the reader floor and the kinds this record requires.",
      "x-vocabularies": ["package_kind"]
    },
    "optionalProperties": {
      "min_vibe_version": {
        "type": "string"
      },
      "requires_kinds": {
        "elements": {
          "ref": "package_kind"
        },
        "metadata": {
          "x-empty": "omit"
        }
      }
    }
  },
  "conflicts_entry": {
    "metadata": {
      "description": "Conflicts projection: packages this version cannot coexist with."
    },
    "optionalProperties": {
      "packages": {
        "elements": {
          "type": "string"
        },
        "metadata": {
          "x-empty": "omit"
        }
      }
    }
  },
  "features_entry": {
    "metadata": {
      "description": "Feature table: feature names map to activation lists; `exclusive` is the at-most-one-of named-group table."
    },
    "optionalProperties": {
      "features": {
        "values": {
          "elements": {
            "type": "string"
          }
        },
        "metadata": {
          "x-empty": "omit"
        }
      },
      "exclusive": {
        "values": {
          "elements": {
            "type": "string"
          }
        },
        "metadata": {
          "x-empty": "omit"
        }
      }
    }
  },
  "i18n_entry": {
    "metadata": {
      "description": "I18n availability: the locales a package carries and its default one."
    },
    "optionalProperties": {
      "available": {
        "elements": {
          "type": "string"
        },
        "metadata": {
          "x-empty": "omit"
        }
      },
      "default": {
        "type": "string"
      }
    }
  },
  "obsoletes_entry": {
    "metadata": {
      "description": "Obsoletes projection: packages this version replaces."
    },
    "optionalProperties": {
      "packages": {
        "elements": {
          "type": "string"
        },
        "metadata": {
          "x-empty": "omit"
        }
      }
    }
  },
  "provides_entry": {
    "metadata": {
      "description": "Provides projection: the capabilities this version exposes."
    },
    "optionalProperties": {
      "capabilities": {
        "elements": {
          "type": "string"
        },
        "metadata": {
          "x-empty": "omit"
        }
      }
    }
  },
  "requires_any_entry": {
    "metadata": {
      "description": "One any-of requirement: the list IS the entry, so an empty list is emitted, never omitted."
    },
    "properties": {
      "one_of": {
        "elements": {
          "type": "string"
        },
        "metadata": {
          "x-empty": "emit"
        }
      }
    }
  },
  "requires_entry": {
    "metadata": {
      "description": "Requires projection: the packages and capabilities this version needs, all of them."
    },
    "optionalProperties": {
      "packages": {
        "elements": {
          "type": "string"
        },
        "metadata": {
          "x-empty": "omit"
        }
      },
      "capabilities": {
        "elements": {
          "type": "string"
        },
        "metadata": {
          "x-empty": "omit"
        }
      }
    }
  },
  "subskill_entry": {
    "metadata": {
      "description": "Subskill delivery projection (PROP-005 §2.6).",
      "x-vocabularies": ["delivery_mode"]
    },
    "properties": {
      "path": {
        "type": "string"
      },
      "delivery": {
        "ref": "delivery_mode"
      }
    },
    "optionalProperties": {
      "describes": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "channels": {
        "elements": {
          "type": "string"
        },
        "metadata": {
          "x-empty": "omit"
        }
      }
    }
  },
  "workspace_origin_entry": {
    "metadata": {
      "description": "`[origin]` projection (PROP-007 §2.8): provenance of a copy published from a workspace member. `generated_at` is a plain ISO-8601 string in code, not a domain timestamp."
    },
    "properties": {
      "upstream": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "generated_by": {
        "type": "string"
      },
      "generated_at": {
        "type": "string"
      }
    },
    "optionalProperties": {
