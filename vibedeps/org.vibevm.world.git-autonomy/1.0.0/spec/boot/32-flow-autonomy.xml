<?xml version="1.0" encoding="UTF-8"?>
<spec xmlns="https://vibevm.org/spec/1">
  <title id="root">Flow: Commit autonomy</title>
  <status stage="impl" state="done"/>
  <p><fact id="THE-DEFAULT-POSTURE-ON-THE-COMMIT-AND-PUSH-SURFACE" status="impl/done">The default posture for how much an agent decides on its own versus stops to ask, on the
**commit and push** surface.</fact></p>
  <section id="routine" title="Routine — proceed without asking">
    <p><fact id="ROUTINE-LARGE-CHANGES-PROCEED-WITHOUT-A-HANDSHAKE" status="impl/done">Routine large changes proceed and are committed/pushed **without** a confirmation handshake:</fact></p>
    <list ordered="false">
      <item><fact id="ROUTINE-IMPLEMENTING-A-PLANNED-MILESTONE" status="impl/done">implementing a planned milestone,</fact></item>
      <item><fact id="ROUTINE-FINISHING-A-FEATURE-SLICE" status="impl/done">finishing a feature slice,</fact></item>
      <item><fact id="ROUTINE-TOUCHING-MANY-FILES-FOR-ONE-REASON" status="impl/done">touching many files for one
  coherent reason.</fact></item>
    </list>
    <p><fact id="the-approval-was-given-upstream" status="spec/done">The approval was given upstream, when the work was authorised; a mid-work
"shall I proceed?" is overhead already paid for.</fact></p>
  </section>
  <section id="red-lines" title="Non-routine — stop and ask first">
    <p><fact id="ASK-FIRST-FOR-ANYTHING-WHOSE-REVERSAL-COSTS-WORK" status="impl/done">Ask first for anything whose reversal costs work:</fact></p>
    <list ordered="false">
      <item><fact id="RED-LINE-REWRITING-PUBLISHED-HISTORY" status="impl/done">rewriting published history (rebase of pushed commits, `git commit --amend` on pushed work);</fact></item>
      <item><fact id="RED-LINE-FORCE-PUSH" status="impl/done">`git push --force` / `--force-with-lease`;</fact></item>
      <item><fact id="RED-LINE-LARGE-BINARY-BLOBS" status="impl/done">bringing in large binary blobs;</fact></item>
      <item><fact id="RED-LINE-CI-SIGNING-OR-SECRETS" status="impl/done">changing CI, signing, or secrets configuration;</fact></item>
      <item><fact id="RED-LINE-ANYTHING-WHOSE-REVERSAL-WOULD-COST-WORK" status="impl/done">**any operation whose reversal would cost work.**</fact></item>
    </list>
    <p><fact id="WHEN-UNCERTAIN-ASK" status="impl/done">**When uncertain, ask.**</fact></p>
    <p><fact id="sibling-document-pointers" status="impl/done">Full protocol: @spec://org.vibevm.world/git-autonomy/flows/autonomy/AUTONOMY-PROTOCOL#root.</fact></p>
  </section>
</spec>
