+    );
+    assert_eq!(
+        row.occurrences[1].emitted.as_ref().unwrap().bytes,
+        nested.len() as u64
+    );
+    assert!(row.raw.is_none());
+    assert!(matches!(
+        report.lanes[0].totals.unique_raw_bytes,
+        Count::Unavailable { .. }
+    ));
+    assert!(matches!(
+        report.lanes[1].totals.unique_raw_bytes,
+        Count::Unavailable { .. }
+    ));
+}
