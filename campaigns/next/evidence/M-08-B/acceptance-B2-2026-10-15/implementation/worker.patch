+    fn expected(&self, composed: bool) -> BTreeMap<String, Vec<u8>> {
+        let mut files = BTreeMap::from([
+            ("SKILL.md".into(), b"body".to_vec()),
+            ("references/deep/a.md".into(), b"nested source".to_vec()),
