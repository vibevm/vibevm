+            put(root, "adapters/demo/references/deep/a.md", "nested source");
+            put(root, "adapters/demo/omit.txt", "excluded local");
+            for mode in ["direct", "composed"] {
+                let source = if mode == "direct" {
+                    "source='upstream'\npath='skills/demo'"
+                } else {
+                    "path='adapters/demo'"
