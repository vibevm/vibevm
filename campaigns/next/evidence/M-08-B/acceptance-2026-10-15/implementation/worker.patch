index 000000000..715e478d0
--- /dev/null
+++ b/crates/vibe-lifecycle/src/mechanism/deploy/plugin/client_state.rs
@@ -0,0 +1,63 @@
+//! Trusted embedding contract for finite client-list currentness. No vendor
+//! storage layout is inferred here; an unqualified client remains unavailable.
+use std::{collections::BTreeMap, path::PathBuf};
+
+/// Exact list semantics selected by the lifecycle owner (currently user scope).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ClientStateBinding {
+    pub client: String,
+    pub coordinate: String,
+    pub scope: String,
+    pub user_home: PathBuf,
+}
+
+/// An owner must account for ALL state affecting the selected list/activation
+/// semantics, including absence and membership. Implementations may only read;
+/// no process, credential/history scan, hydration or publication is permitted.
+/// This trusted Rust injection is not a wire/path grant or a boolean assertion
+/// that an arbitrary vendor layout is complete. Owners document their format.
+pub trait ClientStateOwner: Send + Sync {
+    fn observe(&self, binding: &ClientStateBinding) -> Result<ClientStateWitness, String>;
+}
+
+/// Finite exact file membership and bytes, including selected absent files.
+/// Only the qualified owner can choose this complete closure; SafeFS proves
+/// observations, not the owner's semantic completeness claim.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ClientStateWitness {
+    owner: String,
+    binding: ClientStateBinding,
+    root: PathBuf,
+    files: BTreeMap<String, Option<vibe_safefs::StableFileSnapshot>>,
+}
+impl ClientStateWitness {
+    pub fn observe_files(
+        owner: &str,
+        binding: &ClientStateBinding,
+        root: &std::path::Path,
+        files: &[&str],
+    ) -> Result<Self, String> {
+        if owner.is_empty() || files.is_empty() || files.len() > 64 || !root.is_absolute() {
+            return Err("client-state owner requires a nonempty finite qualified closure".into());
+        }
+        let project = vibe_safefs::Project::open(root).map_err(|e| e.to_string())?;
+        let mut observed = BTreeMap::new();
+        for name in files {
+            let snapshot = project
+                .read_file_snapshot_bounded(name, 1024 * 1024)
+                .map_err(|e| e.to_string())?;
+            if observed.insert((*name).to_owned(), snapshot).is_some() {
+                return Err("duplicate client-state member".into());
+            }
+        }
+        Ok(Self {
+            owner: owner.into(),
+            binding: binding.clone(),
+            root: std::fs::canonicalize(root).map_err(|e| e.to_string())?,
+            files: observed,
+        })
+    }
+    pub(super) fn matches_binding(&self, binding: &ClientStateBinding) -> bool {
+        self.binding == *binding
+    }
+}
diff --git a/crates/vibe-lifecycle/src/mechanism/deploy/plugin/prepared.rs b/crates/vibe-lifecycle/src/mechanism/deploy/plugin/prepared.rs
new file mode 100644
index 000000000..542808407
--- /dev/null
+++ b/crates/vibe-lifecycle/src/mechanism/deploy/plugin/prepared.rs
@@ -0,0 +1,373 @@
+//! In-memory query evidence. This is never apply authority.
+use super::*;
+use crate::process::{ProcessError, ProcessOutput, ProcessSpec};
+use std::path::PathBuf;
+
+#[derive(Clone)]
+pub(super) struct Capture {
+    binding: String,
+    fingerprint_binding: String,
+    executable: ExecutableObservation,
+    state: Option<StateObservation>,
+    pub(super) plan: DeployPlan,
+    pub(super) fingerprint: DeployFingerprint,
+    // Keep exact arguments, environment, exit status and bounded output, not
+    // merely the parsed version. These observations live only in this host.
+    observations: Vec<(ProcessSpec, ProcessOutput)>,
+}
+struct Recorder<'a> {
+    runner: &'a dyn ProcessRunner,
+    observations: Mutex<Vec<(ProcessSpec, ProcessOutput)>>,
+}
+impl ProcessRunner for Recorder<'_> {
+    fn run(&self, spec: &ProcessSpec) -> Result<ProcessOutput, ProcessError> {
+        let output = self.runner.run(spec)?;
+        self.observations
+            .lock()
+            .expect("capture lock")
+            .push((spec.clone(), output.clone()));
+        Ok(output)
+    }
+}
+fn binding(request: &DeployTargetRequest<'_>) -> String {
+    // All borrowed values are engine-owned observations, including exact prior
+    // receipt and intent, selected artifact, profile and injected client paths.
+    framed_hash(
+        "prepared-plugin-request/1",
+        &[("request", &format!("{request:?}"))],
+    )
+}
+fn fingerprint_binding(request: &DeployTargetRequest<'_>) -> String {
+    // Staging and recovery intent belong to the effect transaction, not the
+    // client version/probe fingerprint. The full plan binding retains both.
+    binding(&DeployTargetRequest {
+        staging: None,
+        recovery_intent: None,
+        ..*request
+    })
+}
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct ExecutableObservation {
+    launcher: PathBuf,
+    resolved: PathBuf,
+    state: vibe_safefs::StableFileState,
+    identity: String,
+}
+#[derive(Clone)]
+struct StateObservation {
+    owner: Arc<dyn client_state::ClientStateOwner>,
+    binding: client_state::ClientStateBinding,
+    witness: client_state::ClientStateWitness,
+}
+fn unavailable(request: &DeployTargetRequest<'_>, state: bool) -> MechanismError {
+    DeployProviderError::NeedsPreparation {
+        target: request.target.id.clone(),
+        reason: if state {
+            vibe_wire::generated::adapter_plan::e1::error::ErrorReason::ClientStateUnavailable
+        } else {
+            vibe_wire::generated::adapter_plan::e1::error::ErrorReason::ClientExecutableUnavailable
+        },
+    }
+    .into()
+}
+fn read_executable(
+    path: &std::path::Path,
+    request: &DeployTargetRequest<'_>,
+    initial: bool,
+) -> Result<ExecutableObservation, MechanismError> {
+    let absent = || need(request, !initial);
+    let failed = || unavailable(request, false);
+    if !path.is_absolute() {
+        return Err(failed());
+    }
+    let resolve = || {
+        std::fs::canonicalize(path).map_err(|e| {
+            if e.kind() == std::io::ErrorKind::NotFound {
+                absent()
+            } else {
+                failed()
+            }
+        })
+    };
+    // Resolve only the admitted launcher, never search PATH. Parent and leaf
+    // links participate. The original launcher still goes to ProcessSpec.
+    let resolved = resolve()?;
+    let parent = resolved.parent().ok_or_else(failed)?;
+    let name = resolved
+        .file_name()
+        .and_then(|n| n.to_str())
+        .ok_or_else(failed)?;
+    let project = vibe_safefs::Project::open(parent).map_err(|_| failed())?;
+    let (state, identity) = project
+        .stable_file_state_with_identity(name)
+        .map_err(|_| failed())?
+        .ok_or_else(absent)?;
+    if resolve()? != resolved {
+        return Err(need(request, true));
+    }
+    Ok(ExecutableObservation {
+        launcher: path.into(),
+        resolved,
+        state,
+        identity: identity.observation_correlation_token(),
+    })
+}
+impl Capture {
+    fn executable_current(&self, request: &DeployTargetRequest<'_>) -> Result<(), MechanismError> {
+        if read_executable(&self.executable.launcher, request, false)? != self.executable {
+            return Err(need(request, true));
+        }
+        Ok(())
+    }
+    fn state_current(
+        &self,
+        client: PluginClient,
+        request: &DeployTargetRequest<'_>,
+    ) -> Result<(), MechanismError> {
+        if client == PluginClient::OpenCode {
+            return Ok(());
+        }
+        let state = self
+            .state
+            .as_ref()
+            .ok_or_else(|| unavailable(request, true))?;
+        let now = state
+            .owner
+            .observe(&state.binding)
+            .map_err(|_| unavailable(request, true))?;
+        if now != state.witness {
+            return Err(need(request, true));
+        }
+        Ok(())
+    }
+}
+pub(super) fn need(request: &DeployTargetRequest<'_>, stale: bool) -> MechanismError {
+    DeployProviderError::NeedsPreparation {
+        target: request.target.id.clone(),
+        reason: if stale {
+            vibe_wire::generated::adapter_plan::e1::error::ErrorReason::ClientCaptureStale
+        } else {
+            vibe_wire::generated::adapter_plan::e1::error::ErrorReason::ClientCaptureMissing
+        },
+    }
+    .into()
+}
+impl ClientPluginProvider {
+    pub(super) fn prepare_capture(
+        &self,
+        request: &DeployTargetRequest<'_>,
+    ) -> Result<(), MechanismError> {
+        *self.prepared.lock().expect("capture lock") = None;
+        let executable = self
+            .client
+            .executable(request.clients)
+            .resolved_path()
+            .ok_or_else(|| need(request, false))?
+            .to_owned();
+        let executable = read_executable(&executable, request, true)?;
+        let recorder = Recorder {
+            runner: self.runner.as_ref(),
+            observations: Mutex::new(Vec::new()),
+        };
+        let admitted = self.admit(request)?;
+        let state = if self.client == PluginClient::OpenCode {
+            None
+        } else {
+            let identity = self.cli_identity(request, &admitted)?;
+            let binding = client_state::ClientStateBinding {
+                client: self.client.as_str().into(),
+                coordinate: identity.coordinate,
+                scope: "user".into(),
+                user_home: request.user_home.into(),
+            };
+            self.state_owner
+                .lock()
+                .expect("state owner lock")
+                .clone()
+                .map(|owner| {
+                    let witness = owner
+                        .observe(&binding)
+                        .map_err(|_| unavailable(request, true))?;
+                    if !witness.matches_binding(&binding) {
+                        return Err(unavailable(request, true));
+                    }
+                    Ok(StateObservation {
+                        owner,
+                        binding,
+                        witness,
+                    })
+                })
+                .transpose()?
+        };
+        let version = wire::probe_version(&recorder, self.client, request)?;
+        let plan = if self.client == PluginClient::OpenCode {
+            opencode::plan(
+                request,
+                &admitted.projection,
+                self.config_digest(&admitted.config.name),
+            )?
+        } else {
+            let identity = self.cli_identity(request, &admitted)?;
+            let installed = wire::list(
+                &recorder,
+                self.client,
+                request,
+                &admitted.config.name,
+                &identity.marketplace,
+                &identity.coordinate,
+            )?;
+            self.cli_plan(request, &admitted, identity, installed.as_ref())?
+        };
+        if read_executable(&executable.launcher, request, false)? != executable {
+            return Err(need(request, true));
+        }
+        if let Some(state) = &state {
+            let after = state
+                .owner
+                .observe(&state.binding)
+                .map_err(|_| unavailable(request, true))?;
+            if after != state.witness {
+                return Err(need(request, true));
+            }
+        }
+        let mut fingerprint = self.version_fingerprint(&version);
+        let observations = recorder.observations.into_inner().expect("capture lock");
+        fingerprint.digest = framed_hash(
+            "prepared-plugin-evidence/1",
+            &[
+                ("version", &fingerprint.digest),
+                ("binding", &binding(request)),
+                ("probes", &format!("{observations:?}")),
+                ("launcher_mapping", &format!("{:?}", executable)),
+                (
+                    "client_state",
+                    &format!("{:?}", state.as_ref().map(|s| &s.witness)),
+                ),
+                ("executable_sha256", &executable.state.sha256),
+                ("executable_identity", &executable.identity),
+                (
+                    "executable_mode",
+                    &format!("{:?}", executable.state.unix_mode),
+                ),
+            ],
+        );
+        *self.prepared.lock().expect("capture lock") = Some(Capture {
+            binding: binding(request),
+            fingerprint_binding: fingerprint_binding(request),
+            executable,
+            state,
+            plan,
+            fingerprint,
+            observations,
+        });
+        Ok(())
+    }
+    pub(super) fn preparation_result(
+        &self,
+        request: &DeployTargetRequest<'_>,
+    ) -> Result<(DeployPlan, DeployFingerprint), MechanismError> {
+        let capture = self
+            .prepared
+            .lock()
+            .expect("capture lock")
+            .clone()
+            .ok_or_else(|| need(request, false))?;
+        if capture.fingerprint_binding != fingerprint_binding(request) {
+            return Err(need(request, true));
+        }
+        capture.executable_current(request)?;
+        self.admit(request)?;
+        Ok((capture.plan, capture.fingerprint))
+    }
+    pub(super) fn captured_fingerprint(
+        &self,
+        request: &DeployTargetRequest<'_>,
+        plan: &DeployPlan,
+    ) -> Result<DeployFingerprint, MechanismError> {
+        let capture = self
+            .prepared
+            .lock()
+            .expect("capture lock")
+            .clone()
+            .ok_or_else(|| need(request, false))?;
+        if capture.fingerprint_binding != fingerprint_binding(request) || capture.plan != *plan {
+            return Err(need(request, true));
+        }
+        capture.executable_current(request)?;
+        capture.state_current(self.client, request)?;
+        self.admit(request)?;
+        // Fingerprint obeys exactly the plan currentness rule, including OpenCode.
+        self.captured(request)?;
+        Ok(capture.fingerprint)
+    }
+    pub(super) fn captured(
+        &self,
+        request: &DeployTargetRequest<'_>,
+    ) -> Result<Capture, MechanismError> {
+        let capture = self
+            .prepared
+            .lock()
+            .expect("capture lock")
+            .clone()
+            .ok_or_else(|| need(request, false))?;
+        if capture.binding != binding(request) || capture.observations.is_empty() {
+            return Err(need(request, true));
+        }
+        capture.executable_current(request)?;
+        capture.state_current(self.client, request)?;
+        // Recheck the artifact using its incumbent admission boundary; no
+        // executable lookup or process observation is available here.
+        let admitted = self.admit(request)?;
+        if self.client == PluginClient::OpenCode
+            && opencode::plan(
+                request,
+                &admitted.projection,
+                self.config_digest(&admitted.config.name),
+            )? != capture.plan
+        {
+            return Err(need(request, true));
+        }
+        Ok(capture)
+    }
+}
+
+/// A query has no process port and no effect methods.
+struct ClientObservation {
+    client: PluginClient,
+    capture: Capture,
+}
+impl super::super::protocol::PreparedDeployObservation for ClientObservation {
+    fn current(
+        &self,
+        request: &DeployTargetRequest<'_>,
+    ) -> Result<(DeployPlan, DeployFingerprint), MechanismError> {
+        if self.capture.binding != binding(request) {
+            return Err(need(request, true));
+        }
+        self.capture.executable_current(request)?;
+        self.capture.state_current(self.client, request)?;
+        let artifact = request.artifact.ok_or_else(|| need(request, true))?;
+        let projection =
+            artifact::admit(&request.target.id, self.client.pin(), self.client, artifact)?;
+        if self.client == PluginClient::OpenCode
+            && opencode::plan(
+                request,
+                &projection,
+                self.capture.plan.config_digest.clone(),
+            )? != self.capture.plan
+        {
+            return Err(need(request, true));
+        }
+        Ok((self.capture.plan.clone(), self.capture.fingerprint.clone()))
+    }
+}
+impl ClientPluginProvider {
+    pub(super) fn query_observation(
+        &self,
+    ) -> Option<Box<dyn super::super::protocol::PreparedDeployObservation>> {
+        Some(Box::new(ClientObservation {
+            client: self.client,
+            capture: self.prepared.lock().ok()?.clone()?,
+        }))
+    }
+}
diff --git a/crates/vibe-lifecycle/src/mechanism/deploy/prepared_query.rs b/crates/vibe-lifecycle/src/mechanism/deploy/prepared_query.rs
new file mode 100644
index 000000000..7d8005a8b
--- /dev/null
+++ b/crates/vibe-lifecycle/src/mechanism/deploy/prepared_query.rs
@@ -0,0 +1,194 @@
+//! Explicit preparation followed by a retained, read-only deployment query.
+use super::protocol::{DeployFingerprint, DeployPlan, DeployTargetRequest, ResolvedDeployArtifact};
+use super::state::DeploymentHome;
+use super::view::DeployStateView;
+use super::*;
+use std::path::PathBuf;
+use vibe_wire::generated::{deploy_intent::DeployIntent, deploy_receipt::DeployReceipt};
+
+struct TargetCapture {
+    target: vibe_core::manifest::DeployTarget,
+    observation: Box<dyn super::protocol::PreparedDeployObservation>,
+    home: DeploymentHome,
+    receipt: Option<DeployReceipt>,
+    intent: Option<DeployIntent>,
+    artifact: ResolvedDeployArtifact,
+    plan: DeployPlan,
+    fingerprint: DeployFingerprint,
+}
+/// Host-retained observations. It cannot be supplied to apply or recovery.
+pub struct PreparedDeployQuery {
+    project: PathBuf,
+    settings: PathBuf,
+    user_home: PathBuf,
+    state_home: PathBuf,
+    profile: String,
+    clients: ClientExecutables,
+    targets: Vec<TargetCapture>,
+    reports: Vec<DeployPlanReport>,
+}
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PreparedDeployRow {
+    pub report: DeployPlanReport,
+    pub config_digest: String,
+    pub fingerprint: String,
+    pub reversible: bool,
+}
+fn need(
+    target: &str,
+    reason: vibe_wire::generated::adapter_plan::e1::error::ErrorReason,
+) -> DeployError {
+    crate::mechanism::MechanismError::from(
+        crate::mechanism::error::DeployProviderError::NeedsPreparation {
+            target: target.into(),
+            reason,
+        },
+    )
+    .into()
+}
+pub fn prepare_deploy_query(
+    execution: &DeployExecution<'_>,
+) -> Result<PreparedDeployQuery, DeployError> {
+    prepare_deploy_query_with_client_state_owner(execution, None)
+}
+/// Trusted embedding injection; no request can supply a client-state owner.
+pub fn prepare_deploy_query_with_client_state_owner(
+    execution: &DeployExecution<'_>,
+    owner: Option<std::sync::Arc<dyn ClientStateOwner>>,
+) -> Result<PreparedDeployQuery, DeployError> {
+    let resolved = resolve_query_selection(execution)?;
+    if let Some(owner) = owner {
+        for selected in &resolved {
+            selected.provider.set_client_state_owner(owner.clone());
+        }
+    }
+    // Uses the incumbent selection, artifact and receipt owners exactly once
+    // for preparation; no alternative provider resolver is introduced.
+    let reports = plan::prepare_resolved(execution, &resolved)?;
+    let state = DeployStateView::open(execution.state_home)?;
+    let mut targets = Vec::new();
+    for selected in resolved {
+        let home = home_of(execution, &selected.target.id);
+        let receipt = state.read_receipt(&home)?;
+        let intent = state.read_intent(&home)?;
+        let artifact = artifact::resolve_artifact(execution.project_root, selected.target)?;
+        let request = DeployTargetRequest {
+            target: selected.target,
+            profile: &execution.selection.profile,
+            project_root: execution.project_root,
+            settings_root: execution.settings_root,
+            user_home: execution.user_home,
+            clients: execution.clients,
+            prior_receipt: receipt.as_ref(),
+            recovery_intent: intent.as_ref(),
+            artifact: Some(&artifact),
+            staging: None,
+        };
+        let (plan, fingerprint) = selected.provider.preparation_result(&request)?;
+        let observation = match selected.provider.prepared_query_observation() {
+            Some(observation) => observation,
+            None => {
+                // Exact retained selected row lookup, not another resolution.
+                let pin = selected.pin.parse().expect("selected provider pin");
+                let row = execution
+                    .registry
+                    .find(&pin)
+                    .expect("retained selected row");
+                Box::new(PureBuiltinObservation(builtin_provider(
+                    row.handler(),
+                    &selected.target.mechanism.to_string(),
+                    &selected.pin,
+                )?))
+            }
+        };
+        targets.push(TargetCapture {
+            target: selected.target.clone(),
+            observation,
+            home,
+            receipt,
+            intent,
+            artifact,
+            plan,
+            fingerprint,
+        });
+    }
+    Ok(PreparedDeployQuery {
+        project: execution.project_root.into(),
+        settings: execution.settings_root.into(),
+        user_home: execution.user_home.into(),
+        state_home: execution.state_home.into(),
+        profile: execution.selection.profile.clone(),
+        clients: execution.clients.clone(),
+        targets,
+        reports,
+    })
+}
+impl PreparedDeployQuery {
+    /// Historical preparation identities only, not current plan rows.
+    pub fn evidence_identity(&self) -> String {
+        self.targets
+            .iter()
+            .map(|t| t.fingerprint.digest.as_str())
+            .collect::<Vec<_>>()
+            .join(":")
+    }
+
+    pub fn plan(&self) -> Result<Vec<PreparedDeployRow>, DeployError> {
+        let state = DeployStateView::open(&self.state_home)?;
+        let mut rows = Vec::new();
+        for (capture, report) in self.targets.iter().zip(&self.reports) {
+            let receipt = state.read_receipt(&capture.home)?;
+            let intent = state.read_intent(&capture.home)?;
+            let artifact = artifact::resolve_artifact(&self.project, &capture.target)?;
+            if receipt != capture.receipt
+                || intent != capture.intent
+                || artifact != capture.artifact
+            {
+                return Err(need(
+                    &capture.target.id,
+                    vibe_wire::generated::adapter_plan::e1::error::ErrorReason::ClientCaptureStale,
+                ));
+            }
+            let request = DeployTargetRequest {
+                target: &capture.target,
+                profile: &self.profile,
+                project_root: &self.project,
+                settings_root: &self.settings,
+                user_home: &self.user_home,
+                clients: &self.clients,
+                prior_receipt: receipt.as_ref(),
+                recovery_intent: intent.as_ref(),
+                artifact: Some(&artifact),
+                staging: None,
+            };
+            let (plan, fingerprint) = capture.observation.current(&request)?;
+            if plan != capture.plan || fingerprint != capture.fingerprint {
+                return Err(need(
+                    &capture.target.id,
+                    vibe_wire::generated::adapter_plan::e1::error::ErrorReason::ClientCaptureStale,
+                ));
+            }
+            rows.push(PreparedDeployRow {
+                report: report.clone(),
+                config_digest: plan.config_digest,
+                fingerprint: fingerprint.digest,
+                reversible: plan.reversible,
+            });
+        }
+        Ok(rows)
+    }
+}
+
+/// Only stateless builtins reach this wrapper. Stateful client adapters export
+/// their finite observation directly, and native rows refuse before loading.
+struct PureBuiltinObservation(Box<dyn crate::mechanism::DeployProvider + Send + Sync>);
+impl super::protocol::PreparedDeployObservation for PureBuiltinObservation {
+    fn current(
+        &self,
+        request: &DeployTargetRequest<'_>,
+    ) -> Result<(DeployPlan, DeployFingerprint), crate::mechanism::MechanismError> {
+        let plan = self.0.plan(request)?;
+        let fingerprint = self.0.fingerprint(request, &plan)?;
+        Ok((plan, fingerprint))
+    }
+}
