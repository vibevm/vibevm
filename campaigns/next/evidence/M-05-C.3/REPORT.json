{
  "task": "M-05-C.3",
  "source_head": "905332d46f629ed1d2b2b08117da0f9d5a226343",
  "scope": "Full original C3; carried dirty source preserved and completed in admitted owners. No Git mutation, new crates, Cargo changes, lock schema or runtime control.",
  "changes": [
    "One source-bound NormalizedRequest and C1 catalog pass through PlanningSource, solve, selected manifest metadata, masked solving, conditional expansion and visibility retry.",
    "Workspace roots retain every incoming declaration. Explicit coordinates replace only exact selected-node declarations; other-member original ranges survive and unnamed coordinates retain hold pins.",
    "Incumbent resolvo choice witnesses retain actual OR and capability providers. Naive/SAT retain their actual selected choices and backend identity. Ordinary retained dependency versions also survive route masks.",
    "Configured graph provenance binds exact active declaration slots, including multiple declarations targeting one coordinate, and retains source/content/definition receipts.",
    "Plans carry normalized request/provenance across confirmation. Apply checks fetched graph, normalized roots and selected edge evidence before writes. Admitted intent bypasses legacy empty/fresh shortcuts.",
    "Conditional additions stay in plan/fetch.rs; active constraints are reapplied even for existing nodes, with candidate-bound edge provenance. Unsupported configured/conditional or unstable combinations refuse explicitly.",
    "Governing PROP003 and semantic map preserve C1/C2 contracts, exact defaults and known implications."
  ],
  "criteria": [
    {
      "slot": 0,
      "disposition": "satisfied",
      "evidence": "V1 production source/planner configured metadata, real visibility retry, conditional parity and typed backend conflicts; V2 forwarding/root-union fixtures; V3 selected graph cases. Worker claim only."
    },
    {
      "slot": 1,
      "disposition": "satisfied",
      "evidence": "Recorded solver witnesses bind every final graph edge to declaration/provider identities; production configured/ordinary/conditional tests compare retained provenance; apply rejects altered graph. Worker claim only."
    }
  ],
