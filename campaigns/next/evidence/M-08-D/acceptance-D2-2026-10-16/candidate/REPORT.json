  "scope": {
    "goal": "Run plan/apply/verify/recover/remove through the existing engine and universal operation service.",
    "steps": [
      "Route admitted command/file plans into existing deployment journals and M16 durable operation IDs; avoid a second deploy engine.",
      "Implement independent observed-state checks, cancellation boundaries and recover/remove using retained host operation data.",
      "Expose equivalent typed CLI/API/MCP outcomes including partial effects and newly required authority on expansion."
    ],
    "positive_cases": [
      "A full isolated apply→verify→update→remove preserves foreign state.",
      "Response loss reconnects to the same operation; supported recovery resumes the owned prefix."
    ],
    "negative_cases": [
      "A changed executable/descriptor/grant cannot reuse stale authorization.",
      "Provider error after one effect retains partial state instead of returning only text."
    ],
    "effective_roster_sha256": "6087b89db06ea99e4c9849e938a1e95edf7e504478af2a1eda4952d737bc5b6e",
    "prior_scope_extensions": "Retained machine_session/state.rs trusted route binding and generic/grant.rs additive approval port remain in effective roster and full consumed closure. No additional owner permission needed or requested."
  },
  "corrections": [
    {
      "id": "R1",
      "disposition": "satisfied",
      "implementation": "D1 Host::validate_process_grant performs the original exact Host/Prepared identity and currentness validation without effects. D2 validates every opaque command grant during complete preflight before C3 effects; execute still rechecks.",
      "evidence": "V1 identical_dto_foreign_prepared_grant_refuses_before_files: equal DTO plans prepared twice, first grants refuse second before any file/command effect; fresh matching grant succeeds."
    },
    {
      "id": "R2",
      "disposition": "satisfied",
      "implementation": "Client journal preserves the initial file_subject for the run. Fresh C3 retained approval identity remains separate; target, resource and original grant_subject joins stay strict.",
      "evidence": "V1 repeated_cold_combined_recovery_preserves_original_c3_subject: partial combined apply, cold fresh C3/D1 admission, pre-dispatch cancellation, another cold fresh admission completes same run. Two commands execute once each; foreign JSON member survives."
    },
    {
      "id": "R3",
      "disposition": "satisfied",
      "implementation": "The existing client state retains final reply, exact future receipt digest and generation before receipt publication. Recovery validates receipt content and identity plus exact sidecar and intent joins under incumbent locks, completes promotion/retirement/publication in the same run, then resumes any partial prefix. Pending cancellation is retained during unfinished finalization.",
      "evidence": "V1 receipt_publication_crash_recovers_same_run_and_refuses_foreign_join table-drives completed and partial prefixes at receipt publication, sidecar promotion and intent retirement. Cold fresh-authority recovery completes without repeating landed commands; foreign receipt, sidecar and intent each refuse."
    },
    {
      "id": "R4",
      "disposition": "satisfied",
      "implementation": "Production machine-session run calls the shared dispatch entry with explicit host capability and framed I/O parameters. Trusted composition can supply a ClientDeployRoute; default None refuses. Existing modes retain their own I/O locking.",
      "evidence": "V4 real_cli_dispatch_injected_host_executes_full_lifecycle_and_ungranted_refuses drives real CLI dispatch with initialize and plan/apply/verify/update/remove/recover frames, compares owner outcomes, exercises partial recovery, verifies ten command effects and foreign-state preservation; ungranted dispatch refuses."
    }
  ],
  "criteria": [
    {
      "statement": "External surfaces agree on exact resources, authority decision and terminal/partial status.",
      "disposition": "satisfied",
      "evidence": [
        "V2",
        "V3",
        "V4",
        "V5"
      ]
    },
    {
      "statement": "All lifecycle verbs have executable behavior; plan-only is not acceptance.",
      "disposition": "satisfied",
      "evidence": [
        "V1",
        "V2",
        "V3",
        "V4"
      ]
    }
  ],
