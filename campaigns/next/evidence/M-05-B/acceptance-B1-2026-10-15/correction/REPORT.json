  "retained_implementation": [
    "Preserved the original unaccepted eight-file implementation. Stable DependencyDeclarationId and LocalFeatureRef, FeatureDeclarations, FeatureEffect and FeatureProgram remain the normalized carriers.",
    "One declaration owns source/version/link/access/friend/exclude metadata. Stable qualified IDs ignore vector position, version and package-local aliases. Duplicate and dangling metadata refuse.",
    "The same effect algebra supports optional dependency activation, strong/weak target-feature requests, exported subskills and declared config values. Required and caller-supplied active dependencies seed weak requests; weak-only optional requests stay dormant and merge applies pending requests. Conflicting configs refuse atomically.",
    "Typed and all legacy entrypoints evaluate FeatureProgram through expand_program. No choices.requires grammar or second dependency evaluator. New authored grammar remains unpublished; no B2/B3 changes."
  ],
  "corrections": [
    {
      "finding": "B1-F1",
      "disposition": "satisfied",
      "implementation": "Only the two superseded live M05A2 expectations were corrected; exact names retained. Qualified forwarding preserves group/name and weak strength, and definition validation accepts unselected exclusive alternatives. Existing at-most-one all-features violation assertion retained. Permanent PROP003 adds explicit supersession while preserving history and normative clauses.",
      "checks": [
        "V2-1",
        "V2-2",
        "V5-spec-preservation"
      ]
    },
    {
      "finding": "B1-F2",
      "disposition": "satisfied",
      "implementation": "fetch_node, try_in_place_incremental and configuration_preview now call expand_manifest_features. It normalizes actual requires declarations with required seeds, lowers all local/dependency refs including dormant branches, and uses expand_program. Actual caller tests prove undeclared default/dormant refusal and required weak forwarding.",
      "checks": [
        "V3 7/7",
        "V4 4/4"
      ]
    },
    {
      "finding": "Root partial export catalogue clarification",
      "disposition": "satisfied",
      "implementation": "lower_legacy_dependencies shares lower_legacy_in_context and validate_in_context with the fully declared legacy API. Option<&BTreeSet<String>> distinguishes unavailable export catalogue from known empty. The former preserves syntactically valid selectors without inventing export declarations; the latter remains strict. Config refs remain strict. Core regression and actual fetch/defer/preview preservation cases cover this distinction.",
      "checks": [
        "V1 core unavailable_export_catalogue_is_not_known_empty",
        "V3 fetch_and_defer_preserve_legacy_subskill_selectors",
        "V4 unavailable_export_catalogue_preserves_legacy_subskill_selector"
      ]
    }
  ],
  "original_steps": [
    "Define stable dependency declaration IDs and local feature references under the permanent PROP-003 contract.",
    "Implement effects for dependency activation, strong/weak target-feature requests, exported subskills and declared config values.",
    "Keep source/version/link/visibility metadata once on dependency declarations; option aliases remain package-local."
  ],
  "positive_case_evidence": "optional_activation_and_strong_forwarding_share_effect_set checks optional activation, target forwarding, exported subskill and config through one effect set; typed_and_legacy_expansion_are_identical verifies equality.",
  "negative_case_evidence": "Unknown typed, legacy, dormant and active target IDs refuse; malformed qualified refs refuse; weak-only optional requests stay dormant; actual full-manifest callers refuse undeclared defaults/dormant refs.",
  "criteria": [
