  "original_semantics": {
    "title": "Define explicit source interpretation and its migration",
    "goal": "Place source classification before every semantic consumer.",
    "steps": [
      "Define SourceDescriptor identity/media/interpretation/role/loading/trust and exact-file versus directory-default precedence.",
      "Implement deterministic legacy declaration migration with the reader in this task by extending the incumbent M-13 planner and replay path; support byte-preserving ordered insertions and multiple edits rather than a second executor.",
      "Classify conflicting/unknown old intent as NeedsInput; suffix/content sniffing may validate syntax but cannot enable Vibe semantics."
    ],
    "positive_cases": [
      "An explicit file declaration overrides one less-specific directory default."
    ],
    "negative_cases": [
      "Equally applicable conflicting declarations require typed path-specific input; foreign contents do not become specs by extension, and unchanged comments/values survive insertions."
    ],
    "acceptance": [
      "Reader and executable migration land together with preserved comments/values.",
      "One descriptor identity is available to downstream scanner/resolver/converter consumers."
    ],
    "safe_stop": "Keep ambiguous source interpretation unmodified with a typed migration plan."
  },
