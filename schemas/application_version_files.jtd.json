{
  "metadata": {
    "description": "The version files the installed applications of one home declare: the rows of [[application.version_file]] kept beside the application index, one entry per installation key, so activation and the prompt hook know which file names to look for without reading a package tree.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-075#VERSION-FILE-FORMATS"
    },
    "rustOptions": {
      "package": "vibe_wire::application_version_files"
    },
    "x-rust-type": "ApplicationVersionFiles",
    "x-wire-order": [
      "protocol",
      "installations"
    ]
  },
  "properties": {
    "protocol": {
      "type": "string"
    },
    "installations": {
      "values": {
        "ref": "declaration"
      },
      "metadata": {
        "x-empty": "emit"
      }
    }
  },
  "definitions": {
    "row": {
      "discriminator": "format",
      "mapping": {
        "plain": {
          "metadata": {
            "description": "A one-line version file named by the package; the declaration order of `names` breaks a tie inside one directory."
          },
          "properties": {
            "names": {
              "elements": {
                "type": "string"
              },
              "metadata": {
                "x-empty": "emit"
              }
            }
          }
        },
        "tool-versions": {
          "metadata": {
            "description": "asdf's .tool-versions with this package's key — the short spelling of exactly one `keyed` row, kept in the document because a manifest that authored it serialises back to it (PROP-075#VERSION-FILE-KEYED)."
          },
          "properties": {
            "key": {
              "type": "string"
            }
          }
        },
        "keyed": {
          "metadata": {
            "description": "A file of key/version pairs in which each slot edits only its own line (.sdkmanrc, .tool-versions, mise.toml), with the line syntax this package declared."
          },
          "properties": {
            "names": {
              "elements": {
                "type": "string"
              },
              "metadata": {
                "x-empty": "emit"
              }
            },
            "key": {
              "type": "string"
            },
            "separator": {
              "enum": [
                "equals",
                "whitespace",
                "colon"
              ],
              "metadata": {
                "x-vocabulary": "closed"
              }
            },
            "comment": {
              "enum": [
                "hash",
                "semicolon",
                "none"
              ],
              "metadata": {
                "x-vocabulary": "closed"
              }
            },
            "extra": {
              "enum": [
                "refuse",
                "first"
              ],
              "metadata": {
                "x-vocabulary": "closed"
              }
            }
          }
        }
      }
    },
    "declaration": {
      "metadata": {
        "x-wire-order": [
          "slot",
          "rows"
        ]
      },
      "properties": {
        "slot": {
          "type": "string"
        },
        "rows": {
          "elements": {
            "ref": "row"
          },
          "metadata": {
            "x-empty": "emit"
          }
        }
      }
    }
  }
}
