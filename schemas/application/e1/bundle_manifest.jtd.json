{
  "metadata": {
    "description": "Descriptor embedded in an application distribution ZIP.",
    "spec": { "implements": "spec://org.vibevm.core/vibevm/common/PROP-059#distribution" },
    "rustOptions": { "package": "vibe_wire::application::e1::bundle_manifest" },
    "x-rust-type": "BundleManifest",
    "x-wire-order": ["protocol", "application", "os", "arch", "libc", "sourceCommit", "sourceTree", "management", "launchers", "files"]
  },
  "properties": {
    "protocol": { "type": "string" },
    "application": { "ref": "application_identity" },
    "os": { "type": "string" },
    "arch": { "type": "string" },
    "sourceCommit": { "type": "string" },
    "sourceTree": { "type": "string" },
    "management": { "ref": "bundle_management" },
    "launchers": { "elements": { "ref": "bundle_launcher" }, "metadata": { "x-empty": "emit" } },
    "files": { "elements": { "ref": "bundle_file" }, "metadata": { "x-empty": "emit" } }
  },
  "optionalProperties": {
    "libc": { "type": "string", "metadata": { "x-default": null } }
  },
  "definitions": {
    "byte_count": { "type": "float64", "metadata": { "x-rust-type": "u64" } },
    "package_identity": {
      "metadata": { "x-wire-order": ["group", "name", "version"] },
      "properties": {
        "group": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "application_identity": {
      "metadata": { "x-wire-order": ["id", "package", "installerPackage", "commands"] },
      "properties": {
        "id": { "type": "string" },
        "package": { "ref": "package_identity" },
        "installerPackage": { "ref": "package_identity" },
        "commands": { "elements": { "type": "string" }, "metadata": { "x-empty": "emit" } }
      }
    },
    "bundle_management": {
      "metadata": { "x-wire-order": ["runtime", "entry"] },
      "properties": {
        "runtime": { "type": "string" },
        "entry": { "type": "string" }
      }
    },
    "bundle_launcher": {
      "metadata": { "x-wire-order": ["command", "path", "destination"] },
      "properties": {
        "command": { "type": "string" },
        "path": { "type": "string" },
        "destination": { "type": "string" }
      }
    },
    "bundle_file": {
      "metadata": { "x-wire-order": ["path", "sha256", "size"] },
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "size": { "ref": "byte_count" }
      }
    }
  }
}
