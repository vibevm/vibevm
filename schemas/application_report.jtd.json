{
  "metadata": {
    "description": "Wire format for global user-application install/update/uninstall reports.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-059#commands"
    },
    "rustOptions": {
      "package": "vibe_wire::application_report"
    }
  },
  "properties": {
    "protocol": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "enum": ["install", "update", "uninstall"],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "applicationId": {
      "type": "string"
    },
    "installation": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "slotDefault": {
      "type": "string",
      "nullable": true
    }
  },
  "optionalProperties": {
    "appRoot": {
      "type": "string",
      "metadata": {
        "x-default": null
      }
    },
    "selectedMode": {
      "enum": ["shell", "zip", "tar_gz", "exe", "msi", "source_build"],
      "metadata": {
        "x-vocabulary": "closed",
        "x-default": null
      }
    }
  }
}
