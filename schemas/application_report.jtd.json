{
  "metadata": {
    "description": "Wire format for global user-application install/update/uninstall reports.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-059#commands"
    },
    "rustOptions": {
      "package": "vibe_wire::application_report"
    }
  },
  "properties": {
    "protocol": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "enum": ["install", "update", "uninstall", "modify", "rollback", "expose", "hide", "mark", "hold", "unhold"],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "applicationId": {
      "type": "string"
    },
    "installation": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "slotDefault": {
      "type": "string",
      "nullable": true
    }
  },
  "optionalProperties": {
    "appRoot": {
      "type": "string",
      "metadata": {
        "x-default": null
      }
    },
    "work": {
      "type": "string",
      "metadata": {
        "description": "The work directory an install or update kept because --keep-work was given (PROP-065#work); absent when it was deleted.",
        "x-default": null
      }
    },
    "selectedMode": {
      "enum": ["shell", "zip", "tar_gz", "exe", "msi", "source_build", "steps"],
      "metadata": {
        "x-vocabulary": "closed",
        "x-default": null
      }
    },
    "versionFile": {
      "ref": "version_file",
      "metadata": {
        "description": "The version file --write-version-file wrote and the resolved version it wrote there (PROP-075#VERSION-FILE-WRITE); absent when the flag was not given.",
        "x-default": null
      }
    }
  },
  "definitions": {
    "version_file": {
      "metadata": {
        "description": "A written version file, reported by path with the version written.",
        "x-wire-order": ["path", "version"]
      },
      "properties": {
        "path": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
