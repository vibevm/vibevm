{
  "metadata": {
    "description": "Version 1 of one line of vibe transfers watch --json (PROP-068#verbs): when, what happened (one started per transfer already active at connect, then sample, started, finished, failed, interrupted), the transfer id and batch, the cumulative bytes, the record's total, the rate over the last second, the peak, the record on started and the message of an end.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-068#verbs"
    },
    "rustOptions": {
      "package": "vibe_wire::transfer_event"
    },
    "x-rust-type": "TransferEvent",
    "x-wire-order": [
      "protocol",
      "at",
      "event",
      "id",
      "batch",
      "bytes",
      "total",
      "rate_bps",
      "peak_bps",
      "record",
      "message",
      "disk_written_bytes"
    ]
  },
  "properties": {
    "protocol": {
      "type": "string"
    },
    "at": {
      "type": "string"
    },
    "event": {
      "ref": "event_kind"
    },
    "id": {
      "type": "string"
    },
    "batch": {
      "type": "string"
    }
  },
  "optionalProperties": {
    "bytes": {
      "ref": "count",
      "metadata": {
        "x-default": null,
        "description": "Cumulative since the transfer began, never an increment."
      }
    },
    "total": {
      "ref": "count",
      "metadata": {
        "x-default": null
      }
    },
    "rate_bps": {
      "ref": "count",
      "metadata": {
        "x-default": null
      }
    },
    "peak_bps": {
      "ref": "count",
      "metadata": {
        "x-default": null
      }
    },
    "record": {
      "ref": "record",
      "metadata": {
        "x-default": null,
        "description": "On started."
      }
    },
    "message": {
      "type": "string",
      "metadata": {
        "x-default": null,
        "description": "On failed and interrupted."
      }
    },
    "disk_written_bytes": {
      "metadata": {
        "x-default": null,
        "description": "Canonical unsigned decimal u64 string: ASCII digits only, no leading zeros except 0. Cumulative successful logical disk writes per transfer ID; absent means unknown. Not network bytes, retained size or physical I/O."
      },
      "ref": "disk_written_count"
    }
  },
  "definitions": {
    "count": {
      "type": "float64",
      "metadata": {
        "description": "An exact non-negative count. JTD has no uint64 form, so generated Rust narrows the numeric form to u64.",
        "x-rust-type": "u64"
      }
    },
    "transfer_kind": {
      "enum": [
        "http",
        "git"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "purpose": {
      "enum": [
        "package-source",
        "archive",
        "native-input",
        "package-clone",
        "release-bundle",
        "index-file",
        "other"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "destination": {
      "enum": [
        "store",
        "cache",
        "work",
        "home"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "precision": {
      "enum": [
        "counted",
        "reported"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "outcome": {
      "enum": [
        "finished",
        "failed",
        "interrupted"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "sample": {
      "metadata": {
        "x-wire-order": [
          "at",
          "bytes",
          "rate_bps",
          "disk_written_bytes"
        ]
      },
      "properties": {
        "at": {
          "type": "string"
        },
        "bytes": {
          "ref": "count"
        },
        "rate_bps": {
          "ref": "count"
        }
      },
      "optionalProperties": {
        "disk_written_bytes": {
          "metadata": {
            "x-default": null,
            "description": "Canonical unsigned decimal u64 string: ASCII digits only, no leading zeros except 0. Cumulative successful logical disk writes per transfer ID; absent means unknown. Not network bytes, retained size or physical I/O."
          },
          "ref": "disk_written_count"
        }
      }
    },
    "bucket": {
      "metadata": {
        "x-wire-order": [
          "second",
          "bytes"
        ]
      },
      "properties": {
        "second": {
          "ref": "count"
        },
        "bytes": {
          "ref": "count"
        }
      }
    },
    "record": {
      "metadata": {
        "x-wire-order": [
          "id",
          "batch",
          "kind",
          "url",
          "purpose",
          "package",
          "step",
          "destination",
          "total",
          "started",
          "pid",
          "command",
          "precision",
          "limited",
          "limit_bps",
          "remapped_from",
          "proxy",
          "resume",
          "continues",
          "bytes",
          "peak_bps",
          "samples",
          "last",
          "outcome",
          "message",
          "elapsed_ms",
          "average_bps",
          "series",
          "bucket_seconds",
          "written",
          "disk_written_bytes"
        ]
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "batch": {
          "type": "string"
        },
        "kind": {
          "ref": "transfer_kind"
        },
        "url": {
          "type": "string"
        },
        "purpose": {
          "ref": "purpose"
        },
        "destination": {
          "ref": "destination"
        },
        "started": {
          "type": "string"
        },
        "precision": {
          "ref": "precision"
        },
        "limited": {
          "type": "boolean"
        },
        "pid": {
          "ref": "count"
        },
        "command": {
          "type": "string"
        },
        "bytes": {
          "ref": "count"
        },
        "peak_bps": {
          "ref": "count"
        }
      },
      "optionalProperties": {
        "package": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "step": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "total": {
          "ref": "count",
          "metadata": {
            "x-default": null,
            "description": "The size when the server announced it or the manifest declared it; absent otherwise."
          }
        },
        "limit_bps": {
          "ref": "count",
          "metadata": {
            "x-default": null,
            "description": "The rate limit in force when limited is true (PROP-068#limit)."
          }
        },
        "remapped_from": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "The URL the manifest named when a remap row fetched another (PROP-066)."
          }
        },
        "proxy": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "The proxy the connection went through: scheme://host:port of the configured proxy (never a credential), or px for the vibe-managed px; absent for a direct connection (PROP-068#proxy)."
          }
        },
        "resume": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "The command line that resumes an interrupted command (PROP-068#pause)."
          }
        },
        "continues": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "The id of the interrupted transfer this one continues."
          }
        },
        "samples": {
          "elements": {
            "ref": "sample"
          },
          "metadata": {
            "x-empty": "omit",
            "description": "An active file's samples of the last five minutes."
          }
        },
        "last": {
          "ref": "sample",
          "metadata": {
            "x-default": null,
            "description": "The last sample of an active transfer, in a listing."
          }
        },
        "outcome": {
          "ref": "outcome",
          "metadata": {
            "x-default": null
          }
        },
        "message": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "elapsed_ms": {
          "ref": "count",
          "metadata": {
            "x-default": null
          }
        },
        "average_bps": {
          "ref": "count",
          "metadata": {
            "x-default": null
          }
        },
        "series": {
          "elements": {
            "ref": "bucket"
          },
          "metadata": {
            "x-empty": "omit",
            "description": "Per-second buckets from start to end, at most 3600; bucket_seconds says how wide."
          }
        },
        "bucket_seconds": {
          "ref": "count",
          "metadata": {
            "x-default": null
          }
        },
        "written": {
          "ref": "count",
          "metadata": {
            "x-default": null,
            "description": "A git transfer's size on disk after the operation (the clone's .git/objects): its received bytes are reported, not counted (PROP-068#journal)."
          }
        },
        "disk_written_bytes": {
          "metadata": {
            "x-default": null,
            "description": "Canonical unsigned decimal u64 string: ASCII digits only, no leading zeros except 0. Cumulative successful logical disk writes per transfer ID; absent means unknown. Not network bytes, retained size or physical I/O."
          },
          "ref": "disk_written_count"
        }
      }
    },
    "event_kind": {
      "enum": [
        "started",
        "sample",
        "finished",
        "failed",
        "interrupted"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "disk_written_count": {
      "type": "string",
      "metadata": {
        "x-rust-type": "vibe_core::wire_decimal::DecimalU64",
        "description": "Canonical unsigned decimal u64 logical write count; shared scalar validates exact spelling and range."
      }
    }
  }
}
