{
  "metadata": {
    "description": "Opaque resource octets, explicit original/projected/unavailable position basis, and owner-declared client URI metadata. URI syntax and scope are validated but never grant resource access or authenticate source bytes.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-080#MACHINE-SOURCE-LOCATION",
      "r": 1
    },
    "rustOptions": {
      "package": "vibe_wire::machine::e1::source_location"
    }
  },
  "properties": {
    "schema": {
      "type": "uint8"
    },
    "resource_id_octets": {
      "elements": {
        "type": "uint8"
      },
      "metadata": {
        "x-empty": "emit"
      }
    },
    "captured_revision": {
      "type": "string"
    },
    "client_uri": {
      "type": "string",
      "nullable": true
    },
    "uri_mapping": {
      "ref": "uri_mapping"
    },
    "location": {
      "ref": "location"
    }
  },
  "definitions": {
    "uri_unavailable_reason": {
      "enum": [
        "no_owner_mapping",
        "wrong_scope",
        "wrong_revision",
        "absent_resource"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "uri_mapping": {
      "discriminator": "status",
      "mapping": {
        "owner_declared_unverified": {
          "properties": {
            "authorized_scope_id": {
              "type": "string"
            }
          }
        },
        "unavailable": {
          "properties": {
            "reason": {
              "ref": "uri_unavailable_reason"
            }
          }
        }
      }
    },
    "reason": {
      "enum": [
        "unknown_encoding",
        "raw_bytes_unavailable",
        "missing_reverse_map"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "location": {
      "discriminator": "basis",
      "mapping": {
        "original_bytes": {
          "properties": {
            "encoding": {
              "type": "string"
            },
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        },
        "projected_text": {
          "properties": {
            "projection": {
              "type": "string"
            },
            "encoding": {
              "type": "string"
            },
            "start_line": {
              "type": "string"
            },
            "start_column": {
              "type": "string"
            },
            "end_line": {
              "type": "string"
            },
            "end_column": {
              "type": "string"
            }
          }
        },
        "unavailable": {
          "properties": {
            "reason": {
              "ref": "reason"
            }
          }
        }
      }
    }
  }
}
