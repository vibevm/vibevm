  "metadata": {
    "description": "Owner observation for only the fixed bound vibe-bin Deploy route; never authority. Completed carries the full generated deploy-receipt through a registered nested format. Partial intent/receipt/sidecar observations are explicit and do not prove completion. The adapter enforces epoch, bounds, receipt validation and owner equality.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-080#MACHINE-OPERATION-SERVICE",
