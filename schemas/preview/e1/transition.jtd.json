          "type": "boolean"
        },
        "contributions_verified": {
          "type": "boolean"
        },
        "documentation_verified": {
          "type": "boolean"
        },
        "migration_rehearsed": {
          "type": "boolean"
        },
        "final_product_panel_passed": {
          "type": "boolean"
        }
      }
    },
    "documentation_capture_ref": {
      "properties": {
