          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "capture_file_sha256": {
          "type": "string"
        }
      }
    },
    "source_digest_ref": {
      "properties": {
        "source": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    }
  }
}
