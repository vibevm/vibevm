          }
        }
      },
      "optionalProperties": {
        "capture_id": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "source": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "capture_file_sha256": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "commit_sha1": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "git_tree_sha1": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        }
      }
    },
    "pending_documentation": {
      "properties": {
        "state": {
          "enum": [
            "pending-owner-binding",
            "captured",
            "updated",
            "verified"
          ],
          "metadata": {
            "x-vocabulary": "closed"
          }
        }
      },
      "optionalProperties": {
        "capture_id": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "source": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "capture_file_sha256": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        }
      }
    },
    "pending_guide": {
      "properties": {
