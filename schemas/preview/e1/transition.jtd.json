          "enum": [
            "pending",
            "draft",
            "reviewed",
            "verified"
          ],
          "metadata": {
            "x-vocabulary": "closed"
          }
        }
      },
      "optionalProperties": {
        "source": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "source_sha256": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        }
      }
    },
    "proof_state": {
      "properties": {
