{
  "metadata": {
    "description": "Developer Preview transition index (PROP-081#TRANSITION-INDEX). Shape is generated; stage-dependent evidence is checked by the preview transition validator.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-081#TRANSITION-INDEX"
    },
    "rustOptions": {
      "package": "vibe_wire::preview::e1::transition"
    }
  },
  "properties": {
    "schema": {
      "type": "uint32"
    },
    "record_kind": {
      "enum": [
        "preview-transition"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "schema_status": {
      "type": "string"
    },
    "dp1": {
      "ref": "capture_ref"
    },
    "dp2": {
      "ref": "pending_capture"
    },
    "documentation": {
      "ref": "pending_documentation"
    },
    "change_records": {
      "elements": {
        "type": "string"
      },
      "metadata": {
        "x-empty": "emit"
      }
    },
    "migration_guide": {
      "ref": "pending_guide"
    },
    "proof": {
      "ref": "proof_state"
    }
  },
  "optionalProperties": {
    "contribution_scope": {
      "ref": "contribution_scope",
      "metadata": {
        "x-default": null,
        "description": "Exact before/after capture and record-byte bindings for a selected contribution scope; binding alone is not acceptance.",
        "spec": {
          "implements": "spec://org.vibevm.core/vibevm/common/PROP-081#CONTRIBUTION-SCOPE-PROOF"
        }
      }
    },
    "captures": {
      "elements": {
        "ref": "capture_ref"
      },
      "metadata": {
        "x-default": null,
        "x-empty": "preserve",
        "description": "Additional exact intermediate capture references; retaining a reference alone does not establish its proof.",
        "spec": {
          "implements": "spec://org.vibevm.core/vibevm/common/PROP-081#CAPTURE-CATALOGUE"
        }
      }
    },
    "documentation_base": {
      "ref": "documentation_capture_ref",
      "metadata": {
        "x-default": null,
        "spec": {
          "implements": "spec://org.vibevm.core/vibevm/common/PROP-081#DOCUMENTATION-RETRIEVAL-BINDINGS"
        },
        "description": "Exact retained optional documentation base; retrieval does not grant write ownership or acceptance."
      }
    },
    "documentation_map": {
      "ref": "source_digest_ref",
      "metadata": {
        "x-default": null,
        "spec": {
          "implements": "spec://org.vibevm.core/vibevm/common/PROP-081#DOCUMENTATION-RETRIEVAL-BINDINGS"
        },
        "description": "Exact retained documentation map source and digest; registration does not adopt an input source."
      }
    }
  },
  "definitions": {
    "contribution_scope": {
      "properties": {
        "before_capture_id": { "type": "string" },
        "after_capture_id": { "type": "string" },
        "record_digests": {
          "elements": { "ref": "record_digest" },
          "metadata": { "x-empty": "emit" }
        }
      }
    },
    "record_digest": {
      "properties": {
        "change_id": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "optionalProperties": {
        "required_claim_ids": {
          "elements": { "type": "string" },
          "metadata": {
            "x-default": null,
            "x-empty": "preserve",
            "description": "Explicit proof claims required for this selected contribution; historical attempts remain outside this admission selection."
          }
        }
      }
    },
    "capture_ref": {
      "properties": {
        "capture_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "capture_file_sha256": {
          "type": "string"
        },
        "commit_sha1": {
          "type": "string"
        },
        "git_tree_sha1": {
          "type": "string"
        }
      }
    },
    "pending_capture": {
      "properties": {
        "state": {
          "enum": [
