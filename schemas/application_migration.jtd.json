{
  "metadata": {
    "description": "Version 1 answer of vibe app migrate: the slot, the two versions, the shared work directory and one record per selected migration entry — its outcome and, for a failure, exactly what was not carried (the failing side and step, its log, the work directory and the command that retries it). The same document is the record kept inside the work directory, which is what lets --resume re-run only the import when the export already succeeded.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-075#MIGRATION-FAILURE"
    },
    "rustOptions": {
      "package": "vibe_wire::application_migration"
    },
    "x-rust-type": "ApplicationMigration",
    "x-wire-order": [
      "protocol",
      "ok",
      "slot",
      "from",
      "to",
      "work",
      "resumed",
      "entries",
      "notices"
    ]
  },
  "properties": {
    "protocol": {
      "type": "string"
    },
    "ok": {
      "type": "boolean",
      "metadata": {
        "description": "Every selected entry succeeded; false when any failed."
      }
    },
    "slot": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "metadata": {
        "description": "The installation key the state is carried from."
      }
    },
    "to": {
      "type": "string",
      "metadata": {
        "description": "The installation key the state is carried to; equal to `from` for a maintenance entry."
      }
    },
    "work": {
      "type": "string",
      "metadata": {
        "description": "The shared work directory, always kept, success or failure."
      }
    },
    "resumed": {
      "type": "boolean",
      "metadata": {
        "description": "The run reused a kept work directory and re-ran only what had not succeeded."
      }
    },
    "entries": {
      "elements": {
        "ref": "entry"
      },
      "metadata": {
        "x-empty": "emit"
      }
    }
  },
  "definitions": {
    "outcome": {
      "enum": [
        "done",
        "export_failed",
        "import_failed",
        "skipped",
        "pending"
      ],
      "metadata": {
        "x-vocabulary": "closed",
        "description": "done both sides ran; export_failed the export stopped the entry before its import and changed nothing; import_failed the new version stays installed and the slot default stays where the user put it; skipped the entry was not selected; pending the export succeeded and the import has not run yet."
      }
    },
    "side": {
      "enum": [
        "export",
        "import"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "entry": {
      "metadata": {
        "x-wire-order": [
          "id",
          "name",
          "outcome",
          "description",
          "side",
          "step",
          "log",
          "reason",
          "retry",
          "started",
          "finished"
        ]
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outcome": {
          "ref": "outcome"
        }
      },
      "optionalProperties": {
        "description": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "side": {
          "ref": "side",
          "metadata": {
            "x-default": null,
            "description": "The side that failed, or the last side that ran."
          }
        },
        "step": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "The step declaration's own id, as the package wrote it."
          }
        },
        "log": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "The output log of that side, inside the kept work directory."
          }
        },
        "reason": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "Why the side failed, or why the entry was not selected."
          }
        },
        "retry": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "The exact command that retries this entry over the kept work directory."
          }
        },
        "started": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "finished": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        }
      }
    }
  },
  "optionalProperties": {
    "notices": {
      "elements": {
        "type": "string"
      },
      "metadata": {
        "x-empty": "omit",
        "description": "What the run reported and did not fail on."
      }
    }
  }
}
