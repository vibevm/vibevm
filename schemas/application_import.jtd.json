{
  "metadata": {
    "description": "Version 1 answer of vibe app import --json (PROP-059#portable-set): the installations the import installed (or, under --dry-run, would install), the rows it skipped with the reason, the rows it refused with the stable error code and message, and the licences the rows it installs (or would install) still need accepted, with the absolute path of each text so a caller shows it before the run. A skipped row whose key carries `#` is a launcher of the arrangement that could not be restored. Any refused row makes the command exit 1.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-059#portable-set"
    },
    "rustOptions": {
      "package": "vibe_wire::application_import"
    },
    "x-rust-type": "ApplicationImport",
    "x-wire-order": [
      "protocol",
      "home",
      "dry_run",
      "installed",
      "skipped",
      "refused",
      "licenses"
    ]
  },
  "properties": {
    "protocol": {
      "type": "string"
    },
    "home": {
      "type": "string"
    },
    "dry_run": {
      "type": "boolean"
    },
    "installed": {
      "elements": {
        "type": "string"
      },
      "metadata": {
        "x-empty": "emit"
      }
    },
    "skipped": {
      "elements": {
        "ref": "skipped"
      },
      "metadata": {
        "x-empty": "emit"
      }
    },
    "refused": {
      "elements": {
        "ref": "refused"
      },
      "metadata": {
        "x-empty": "emit"
      }
    },
    "licenses": {
      "elements": {
        "ref": "license"
      },
      "metadata": {
        "x-empty": "emit"
      }
    }
  },
  "definitions": {
    "skipped": {
      "metadata": {
        "x-wire-order": [
          "key",
          "reason"
        ]
      },
      "properties": {
        "key": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "refused": {
      "metadata": {
        "x-wire-order": [
          "key",
          "code",
          "message"
        ]
      },
      "properties": {
        "key": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "license": {
      "metadata": {
        "x-wire-order": [
          "key",
          "name",
          "file"
        ]
      },
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      }
    }
  }
}
