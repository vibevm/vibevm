{
  "metadata": {
    "description": "Epoch-1 `.vibe/package-skills.toml` ownership receipt for project-scope package skill projections.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-054#PHASE-PACKAGE"
    },
    "rustOptions": {
      "package": "vibe_wire::package_skill_receipt"
    }
  },
  "properties": {
    "schema": { "type": "uint32" },
    "binding": {
      "elements": { "ref": "package_skill_binding" },
      "metadata": { "x-empty": "emit" }
    }
  },
  "optionalProperties": {
