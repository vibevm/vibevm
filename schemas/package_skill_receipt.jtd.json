          "metadata": { "x-empty": "emit" }
        }
      }
    },
    "package_skill_binding": {
      "metadata": {
        "spec": {
          "documents": "spec://org.vibevm.core/vibevm/common/PROP-018#PROJECTION-DEF"
        }
      },
      "properties": {
        "key": { "type": "string" },
        "provider": { "type": "string" },
        "skill": { "type": "string" },
        "source_snapshot": { "type": "string" },
        "target": {
          "elements": { "ref": "package_skill_target" },
          "metadata": { "x-empty": "emit" }
        }
      }
    },
    "package_skill_target": {
      "properties": {
        "agent": { "type": "string" },
        "path": { "type": "string" },
        "file": {
          "elements": { "ref": "package_skill_file" },
          "metadata": { "x-empty": "emit" }
        }
      }
    },
    "package_skill_file": {
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    }
  }
}
