{
  "metadata": {
    "description": "Version 1 machine list from vibe app launchers --all [--menu] --json: the launch points of every ready, exposed installation of the selected home in one answer (PROP-059#menu). Each installation entry has the shape of one vibe app launchers PACKAGE --json document plus its key and whether it is its slot's default.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-059#menu"
    },
    "rustOptions": {
      "package": "vibe_wire::application_launchers_all"
    }
  },
