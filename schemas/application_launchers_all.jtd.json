{
  "metadata": {
    "description": "Version 2 of the launcher catalog from vibe app launchers --all [--menu] --json: the launch points of every ready, exposed installation of the selected home in one answer, the home they belong to and the catalog revision a client compares instead of the whole document (PROP-059#launcher-catalog). Each installation entry has the shape of one vibe app launchers PACKAGE --json document plus its key and whether it is its slot's default.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-059#launcher-catalog"
    },
    "rustOptions": {
      "package": "vibe_wire::application_launchers_all"
    }
  },
  "properties": {
    "protocol": {
      "type": "string"
    },
    "menu_only": {
      "type": "boolean"
    },
    "home": {
      "type": "string"
    },
    "revision": {
      "ref": "count"
    },
    "installations": {
      "elements": {
        "ref": "installation"
      },
      "metadata": {
        "x-empty": "emit"
      }
    }
  },
  "definitions": {
    "package_identity": {
      "properties": {
        "group": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "launcher": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "nullable": true
        },
        "default": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        },
        "executable": {
          "ref": "path_value"
        },
        "args": {
          "ref": "args_value"
        },
        "working_directory": {
          "ref": "path_value"
        },
        "icon": {
          "ref": "icon_value"
        },
        "status": {
          "ref": "launcher_status"
        },
        "reason": {
          "type": "string",
          "nullable": true
        },
        "kind": {
          "ref": "launcher_kind"
        },
        "menu": {
          "type": "boolean"
        },
        "source": {
          "ref": "launcher_source"
        },
        "categories": {
          "ref": "string_list"
        },
        "keywords": {
          "ref": "string_list"
        },
        "generic_name": {
          "type": "string",
          "nullable": true
        },
        "names": {
          "values": {
            "type": "string"
          },
          "metadata": {
            "x-empty": "emit"
          }
        },
        "descriptions": {
          "values": {
            "type": "string"
          },
          "metadata": {
            "x-empty": "emit"
          }
        },
        "window_class": {
          "type": "string",
          "nullable": true
        },
        "mime_types": {
          "ref": "string_list"
        },
        "actions": {
          "elements": {
            "ref": "launcher_action"
          },
          "metadata": {
            "x-empty": "emit"
          }
        },
        "icon_set": {
          "ref": "icon_set",
          "nullable": true
        },
        "key": {
          "type": "string"
        },
        "collections": {
          "ref": "string_list"
        },
        "pinned": {
          "elements": {
            "ref": "pin_target"
          },
          "metadata": {
            "x-empty": "emit"
          }
        },
        "hidden_by": {
          "ref": "hidden_by",
          "nullable": true
        },
        "display_name": {
          "type": "string"
        },
        "display_icon": {
          "type": "string",
          "nullable": true
        },
        "usage": {
          "ref": "launcher_usage"
        }
      }
    },
    "path_value": {
      "properties": {
        "template": {
          "type": "string",
          "nullable": true
        },
        "base": {
          "type": "string"
        },
        "resolved": {
          "type": "string",
          "nullable": true
        }
      }
    },
    "args_value": {
      "properties": {
        "template": {
          "elements": {
            "type": "string"
          },
          "metadata": {
            "x-empty": "emit"
          }
        },
        "resolved": {
          "ref": "string_list",
          "nullable": true
        }
      }
    },
    "icon_value": {
      "properties": {
        "template": {
          "type": "string",
          "nullable": true
        },
        "resolved": {
          "type": "string",
          "nullable": true
        },
        "diagnostic": {
          "type": "string",
          "nullable": true
        }
      }
    },
    "launcher_status": {
      "enum": [
        "available",
        "requires_project",
        "unavailable"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "string_list": {
      "elements": {
        "type": "string"
      },
      "metadata": {
        "x-empty": "emit"
      }
    },
    "launcher_kind": {
      "enum": [
        "gui",
        "tui",
        "command"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "launcher_source": {
      "enum": [
        "authored",
        "desktop-entry"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "icon_slot": {
      "enum": [
        "svg",
        "png",
        "ico",
        "icns",
        "symbolic"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "icon_file": {
      "properties": {
        "slot": {
          "ref": "icon_slot"
        },
        "size": {
          "type": "uint32",
          "nullable": true
        },
        "template": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "nullable": true
        },
        "diagnostic": {
          "type": "string",
          "nullable": true
        }
      }
    },
    "icon_set": {
      "metadata": {
        "description": "An icon set of PROP-059#menu with every file resolved to an absolute path when it exists; size is the raster's pixel size."
      },
      "properties": {
        "maskable": {
          "type": "boolean"
        },
        "files": {
          "elements": {
            "ref": "icon_file"
          },
          "metadata": {
            "x-empty": "emit"
          }
        }
      }
    },
    "launcher_action": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "ref": "args_value"
        },
        "icon_set": {
          "ref": "icon_set",
          "nullable": true
        }
      }
    },
    "installation": {
      "properties": {
        "key": {
          "type": "string"
        },
        "default": {
          "type": "boolean"
        },
        "application_id": {
          "type": "string"
        },
        "package": {
          "ref": "package_identity"
        },
        "default_launcher_id": {
          "type": "string",
          "nullable": true
        },
        "app_root": {
          "type": "string",
          "nullable": true
        },
        "launchers": {
          "elements": {
            "ref": "launcher"
          },
          "metadata": {
            "x-empty": "emit"
          }
        },
        "menu_group": {
          "type": "string",
          "nullable": true
        },
        "categories": {
          "ref": "string_list"
        },
        "keywords": {
          "ref": "string_list"
        },
        "icon_set": {
          "ref": "icon_set",
          "nullable": true
        },
        "state": {
          "ref": "installation_state"
        }
      }
    },
    "count": {
      "metadata": {
        "description": "An exact non-negative count. JTD has no uint64 form, so generated Rust narrows the numeric form to u64.",
        "x-rust-type": "u64"
      },
      "type": "float64"
    },
    "pin_target": {
      "enum": [
        "taskbar",
        "favorites"
      ],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "hidden_by": {
      "metadata": {
        "description": "Who hid the launcher: only the user can, and a package that declares menu = false is not hidden but simply not in a menu.",
        "x-vocabulary": "closed"
      },
      "enum": [
        "user"
      ]
    },
    "launcher_usage": {
      "metadata": {
        "description": "What the home recorded about starts of this launcher through vibe (PROP-059#launcher-catalog); last_started is RFC 3339."
      },
      "properties": {
        "starts": {
          "ref": "count"
        },
        "last_started": {
          "type": "string",
          "nullable": true
        }
      }
    },
    "installation_state": {
      "metadata": {
        "description": "The state of one installation: hidden exposure, an update hold, and whether a newer version is available — null when answering that would need a registry call."
      },
      "properties": {
        "hidden": {
          "type": "boolean"
        },
        "held": {
          "type": "boolean"
        },
        "update_available": {
          "type": "boolean",
          "nullable": true
        }
      }
    }
  }
}
