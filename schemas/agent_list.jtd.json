{
  "metadata": {
    "description": "Version 1 listing of the configured agent hooks from vibe agent list --json: the default definition, the trusted groups as this user's agents.toml writes them, the effective trust that decides whether a group's package-authored code runs unasked, every definition of <settings>/agents.toml merged with its preset, and the external registration of this process when one is set.",
    "spec": { "implements": "spec://org.vibevm.core/vibevm/common/PROP-064#presets" },
    "rustOptions": { "package": "vibe_wire::agent_list" },
    "x-rust-type": "AgentList",
    "x-wire-order": ["protocol", "path", "default", "trusted_groups", "trust", "agents", "external", "launchers"]
  },
  "properties": {
    "protocol": { "type": "string" },
    "path": { "type": "string" },
    "agents": { "elements": { "ref": "agent" }, "metadata": { "x-empty": "emit" } }
  },
  "optionalProperties": {
    "default": { "type": "string", "metadata": { "x-default": null } },
    "trusted_groups": { "elements": { "type": "string" }, "metadata": { "x-empty": "omit" } },
    "trust": { "ref": "trust", "metadata": { "x-default": null } },
    "external": { "ref": "external", "metadata": { "x-default": null } },
    "launchers": { "elements": { "ref": "launcher" }, "metadata": { "x-empty": "omit" } }
  },
  "definitions": {
    "trust": {
      "metadata": {
        "description": "The effective trust of this machine (PROP-065 #ordinary-trust): every entry of the trusted list with the layer that wrote it, and every entry of the deny list, which overrides the trusted entries whatever layer wrote either one. trusted_groups above is the user's own file as written; this is the resolved answer every consumer reads.",
        "x-wire-order": ["trusted", "untrusted"]
      },
      "properties": {
        "trusted": { "elements": { "ref": "trust_entry" }, "metadata": { "x-empty": "emit" } },
        "untrusted": { "elements": { "ref": "trust_entry" }, "metadata": { "x-empty": "emit" } }
      }
    },
    "trust_entry": {
      "metadata": {
        "description": "One written entry: an exact group (org.example) or the subtree org.example.* that covers the group itself and everything below it. source is base (the list vibe ships), site (the applied site profile's [trust] table), user (<settings>/agents.toml) or run (granted for this run alone). overrides, on a deny entry, names the layers whose trusted entries it takes away.",
        "x-wire-order": ["pattern", "source", "overrides"]
      },
      "properties": {
        "pattern": { "type": "string" },
        "source": { "type": "string" }
      },
      "optionalProperties": {
        "overrides": { "elements": { "type": "string" }, "metadata": { "x-empty": "omit" } }
      }
    },
    "agent": {
      "metadata": { "x-wire-order": ["name", "preset", "command", "interactive", "unattended", "cwd", "env", "extra_args", "default", "problem"] },
      "properties": {
        "name": { "type": "string" },
        "interactive": { "elements": { "type": "string" }, "metadata": { "x-empty": "emit" } },
        "unattended": { "elements": { "type": "string" }, "metadata": { "x-empty": "emit" } },
        "default": { "type": "boolean" }
      },
      "optionalProperties": {
        "preset": { "type": "string", "metadata": { "x-default": null } },
        "command": { "type": "string", "metadata": { "x-default": null } },
        "cwd": { "type": "string", "metadata": { "x-default": null } },
        "env": { "values": { "type": "string" }, "metadata": { "x-empty": "omit" } },
        "extra_args": { "elements": { "type": "string" }, "metadata": { "x-empty": "omit" } },
        "problem": { "type": "string", "metadata": { "x-default": null } }
      }
    },
    "launcher": {
      "metadata": {
        "description": "One PROP-076 agent launcher: a name bound to a harness kind and to the argv prefix that starts it. source is built-in or the exact user-config path, because a developer debugging which program ran needs to know which file decided it.",
        "x-wire-order": ["name", "kind", "command", "config_dir", "source"]
      },
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "command": { "elements": { "type": "string" }, "metadata": { "x-empty": "emit" } },
        "source": { "type": "string" }
      },
      "optionalProperties": {
        "config_dir": { "type": "string", "metadata": { "x-default": null } }
      }
    },
    "external": {
      "metadata": { "x-wire-order": ["command", "args"] },
      "properties": {
        "command": { "type": "string" },
        "args": { "elements": { "type": "string" }, "metadata": { "x-empty": "emit" } }
      }
    }
  }
}
