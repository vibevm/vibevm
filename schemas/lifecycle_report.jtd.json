{
  "metadata": {
    "description": "Wire format for the final `vibe <phase> --json` lifecycle report. Source of truth for `crates/vibe-wire/src/generated/lifecycle_report/`.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-000#JTD-SSOT"
    },
    "rustOptions": {
      "package": "vibe_wire::lifecycle_report"
    }
  },
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "command": {
      "type": "string",
      "metadata": {
        "description": "Always `\"lifecycle\"` for this report."
      }
    },
    "requested": {
      "type": "string",
      "metadata": {
        "description": "The exact default-lifecycle phase requested by the user."
      }
    },
    "chain": {
      "elements": {
        "type": "string"
      },
      "metadata": {
        "x-empty": "emit",
        "description": "The executed phase spellings in order, including a leading `clean` when the clean lifecycle was composed."
      }
    },
    "steps": {
      "elements": {
        "ref": "lifecycle_step_report"
      },
      "metadata": {
        "x-empty": "emit",
        "description": "One outcome for every phase in `chain`, in the same order."
      }
    },
    "contributions": {
      "elements": {
        "ref": "lifecycle_contribution_report"
      },
      "metadata": {
        "x-empty": "emit",
        "description": "Effective lifecycle contributions in canonical execution order. R2.3 reports these as planned; it does not dispatch handlers."
      }
    },
    "notices": {
      "elements": {
        "type": "string"
      },
      "metadata": {
        "x-empty": "emit",
        "description": "Non-fatal collection notices that must remain observable in structured output."
      }
    }
  },
  "definitions": {
    "lifecycle_contribution_report": {
      "properties": {
        "key": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "point": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "metadata": {
            "description": "R2.3 writes `planned`: the handler was selected and narrated, never run."
          }
        }
      },
      "optionalProperties": {
        "version": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        }
      }
    },
    "lifecycle_step_report": {
      "properties": {
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "metadata": {
            "description": "Phase outcome vocabulary. R2.2/R2.3 write `ok`, `fresh`, `no-op`, or `planned`; later engine slices may add already normative outcomes without breaking older readers."
          }
        }
      }
    }
  }
}
