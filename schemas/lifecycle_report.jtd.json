{
  "metadata": {
    "description": "Wire format for the final `vibe <phase> --json` lifecycle report. Source of truth for `crates/vibe-wire/src/generated/lifecycle_report/`.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-000#JTD-SSOT"
    },
    "rustOptions": {
      "package": "vibe_wire::lifecycle_report"
    }
  },
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "command": {
      "type": "string",
      "metadata": {
        "description": "Always `\"lifecycle\"` for this report."
      }
    },
    "requested": {
      "type": "string",
      "metadata": {
        "description": "The exact default-lifecycle phase requested by the user."
      }
    },
    "chain": {
      "elements": {
        "type": "string"
      },
      "metadata": {
        "x-empty": "emit",
        "description": "The executed phase spellings in order, including a leading `clean` when the clean lifecycle was composed."
      }
    },
    "steps": {
      "elements": {
        "ref": "lifecycle_step_report"
      },
      "metadata": {
        "x-empty": "emit",
        "description": "One outcome for every phase in `chain`, in the same order."
      }
    },
    "contributions": {
      "elements": {
        "ref": "lifecycle_contribution_report"
      },
      "metadata": {
        "x-empty": "emit",
        "description": "Effective lifecycle contributions in canonical execution order with their execution outcomes."
      }
    },
    "notices": {
      "elements": {
        "type": "string"
      },
      "metadata": {
        "x-empty": "emit",
        "description": "Non-fatal collection notices that must remain observable in structured output."
      }
    }
  },
  "definitions": {
    "lifecycle_contribution_report": {
      "properties": {
        "key": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "point": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "metadata": {
            "description": "Honest handler outcome such as `ok`, `fail`, or `skip`."
          }
        }
      },
      "optionalProperties": {
        "flagged": {
          "type": "boolean",
          "metadata": {
            "x-default": null,
            "description": "True when a durable operation completed but this contribution left it requiring attention."
          }
        },
        "message": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "Structured handler message. Human mode may render it; JSON mode never leaks it outside this document."
          }
        },
        "reference": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "Authored source reference for a synthetic or translated lifecycle contribution."
          }
        },
        "slot_target": {
          "ref": "slot_target",
          "metadata": {
            "x-default": null,
            "description": "Package slot whose pre/post-install timing event this contribution targeted."
          }
        },
        "stdout": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "Bounded UTF-8 lossy capture of script stdout for structured lifecycle reports, at most 1 MiB. Binary stdout is the reply protocol and is never stored here."
          }
        },
        "stderr": {
          "type": "string",
          "metadata": {
            "x-default": null,
            "description": "Bounded UTF-8 lossy capture of handler stderr for structured lifecycle reports, at most 1 MiB."
          }
        },
        "stdout_truncated": {
          "type": "boolean",
          "metadata": {
            "x-default": null,
            "description": "True when stdout exceeded the 1 MiB structured-report bound and was truncated."
          }
        },
        "stderr_truncated": {
          "type": "boolean",
          "metadata": {
            "x-default": null,
            "description": "True when stderr exceeded the 1 MiB structured-report bound and was truncated."
          }
        },
        "version": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        }
      }
    },
    "slot_target": {
      "properties": {
        "group": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      }
    },
    "lifecycle_step_report": {
      "properties": {
        "phase": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "metadata": {
            "description": "Phase outcome vocabulary. R2.4 writes `ok`, `fresh`, or `no-op`; the first handler failure aborts the chain."
          }
        }
      }
    }
  }
}
