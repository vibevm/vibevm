{
  "metadata": {
    "description": "`.vibe-slot.toml` schema 2 — source identity, complete materialiser-owned footprint and typed failed-conversion outcome for one dependency slot (PROP-054 §14.3, PROP-045 #FAILED-CONVERSION-OUTCOME). Schema 1 remains readable with its original meanings.",
    "spec": {
      "implements": "spec://org.vibevm.core/vibevm/common/PROP-054#REF-SLOT-RECORD"
    },
    "rustOptions": {
      "package": "vibe_wire::slot_record"
    }
  },
  "properties": {
    "schema": {
      "type": "uint32"
    },
    "source_hash": {
      "type": "string"
    },
    "spec_format": {
      "enum": ["mixed", "markdown", "xml"],
      "metadata": {
        "x-vocabulary": "closed"
      }
    },
    "file": {
      "elements": {
        "ref": "slot_file"
      },
      "metadata": {
        "x-empty": "emit",
        "description": "Sorted materialiser-owned payload rows. The record itself and every unrecorded path are outside this list."
      }
    }
  },
  "optionalProperties": {
    "converter_recipe": {
      "type": "string",
      "metadata": {
        "x-default": null
      }
    },
    "derived_hash": {
      "type": "string",
      "metadata": {
        "x-default": null
      }
    },
    "overlay_hash": {
      "type": "string",
      "metadata": {
        "x-default": null
      }
    }
  },
  "definitions": {
    "slot_file": {
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "optionalProperties": {
        "source": {
          "type": "string",
          "metadata": {
            "x-default": null
          }
        },
        "disposition": {
          "enum": ["converted", "copied", "copied-unconverted"],
          "metadata": {
            "x-default": null,
            "x-vocabulary": "closed"
          }
        },
        "conversion_failure": {
          "ref": "conversion_failure",
          "metadata": {
            "x-default": null,
            "description": "Required only when disposition is copied-unconverted; contains every fatal parser issue from the same captured source bytes, while install emits one warning for the failed file."
          }
        }
      }
    },
    "conversion_failure": {
      "properties": {
        "issues": { "elements": { "ref": "conversion_issue" }, "metadata": { "x-empty": "emit" } }
      }
    },
    "conversion_issue": {
      "properties": {
        "class": {
          "enum": ["Vocabulary", "Malformed", "MissingAttr", "Stranded", "MidParagraph", "DuplicateStatus", "WrapperMismatch", "Unmarked", "MissingAnchor", "DuplicateId", "FenceBinding", "TerminalRequirements", "SwallowedAnchor", "PivotAdapter"],
          "metadata": { "x-vocabulary": "closed", "description": "The progress-core IssueCode variant rendered by facts check, or PivotAdapter when markup parsed but the converter adapter refused." }
        },
        "line": { "type": "uint32" },
        "message": { "type": "string" }
      }
    }
  }
}
