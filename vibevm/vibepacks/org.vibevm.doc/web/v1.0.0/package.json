{
  "name": "@vibe-docs/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The vibevm.org site: the landing, the documentation reader, the design system they share, and the two adapters that build them.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "floor": "pnpm run floor:discipline && pnpm run audit:contrast",
    "floor:discipline": "node tools/floor.mjs",
    "audit:contrast": "node design/audit/contrast.mjs",
    "build:static": "node tools/build.mjs static",
    "build:embedded": "node tools/build.mjs embedded",
    "test:e2e": "playwright test -c site/tests/playwright.config.ts",
    "test:local-launcher": "node --test tooling/local-site/*.test.mjs",
    "test:site-build": "node --test tooling/site-build/*.test.mjs",
    "serve:local": "node tooling/local-site/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@qwik.dev/core": "2.0.0-beta.43",
    "@qwik.dev/router": "2.0.0-beta.43",
    "@types/node": "26.5.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.1"
  }
}
